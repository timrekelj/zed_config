{
  "code_lens": "on",
  "ui_font_family": "SF Mono",
  "buffer_font_family": "SF Mono",
  "terminal": { "font_family": "SF Mono" },
  "edit_predictions": {
    "provider": "zed",
    "mode": "subtle"
  },
  "lsp": { "deno": { "settings": { "deno": { "enable": true, }, }, }, },
  "indent_guides": { "enabled": false, },
  "session": { "trust_all_worktrees": true, },
  "languages": {
    "GDScript": { "tab_size": 4, },
    "JSON": { "tab_size": 2, },
    "Go": { "tab_size": 4, },
    "TypeScript": {
      "language_servers": ["deno", "!typescript-language-server", "!vtsls", "!eslint"],
      "formatter": "language_server",
    },
    "JavaScript": {
      "language_servers": ["deno", "!typescript-language-server", "!vtsls", "!eslint"],
      "formatter": "language_server",
    },
    "TSX": {
      "language_servers": ["deno", "!typescript-language-server", "!vtsls", "!eslint"],
      "formatter": "language_server",
    },
  },
  "soft_wrap": "editor_width",
  "theme": {
    "light": "One Light",
    "dark": "Better Cursor",
  },
  "project_panel": { "indent_guides": { "show": "never" } },
  "outline_panel": { "button": false },
  "collaboration_panel": { "button": false },
  "wrap_guides": [100],
  "confirm_quit": true,
  "cursor_blink": false,
  "scrollbar": { "axes": { "vertical": false, }, },
  "tabs": {
    "file_icons": true,
    "git_status": true,
    "activate_on_close": "left_neighbour",
  },
  "relative_line_numbers": "enabled",
  "tab_size": 2,
  "vim_mode": true,
  "vim": { "use_system_clipboard": "never", },
  "toolbar": {
    "agent_review": false,
    "selections_menu": false,
    "breadcrumbs": false,
    "quick_actions": false,
  },
}
