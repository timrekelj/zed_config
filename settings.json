{
    "languages": {
        "JSON": {
            "tab_size": 2
        }
    },
    "helix_mode": false,
    "soft_wrap": "editor_width",
    "icon_theme": "Colored Zed Icons Theme Dark",
    "agent": {
        "tool_permissions": {
            "default": "allow"
        },
        "show_turn_stats": true,
        "use_modifier_to_send": false,
        "default_profile": "write",
        "model_parameters": [],
        "default_model": {
            "enable_thinking": false,
            "provider": "zed.dev",
            "model": "gemini-3-flash"
        }
    },
    "agent_ui_font_size": 18,
    "show_edit_predictions": true,
    "edit_predictions": {
        "provider": "zed",
        "mode": "subtle",
    },
    "theme": "VSCode Dark Modern",
    "auto_install_extensions": {
        "html": true,
        "postgres-context-server": true,
        "sql": true,
        "odin": true,
        "toml": true,
        "lua": true,
        "vscode-dark-modern": true,
        "colored-zed-icons-theme": true
    },
    "git_panel": {
        "tree_view": true,
        "dock": "right",
        "button": true
    },
    "project_panel": {
        "entry_spacing": "standard",
        "auto_fold_dirs": false,
        "indent_guides": { "show": "never" },
        "indent_size": 20
    },
    "notification_panel": { "button": false },
    "outline_panel": { "button": false },
    "collaboration_panel": { "button": false },
    "wrap_guides": [100],
    "unnecessary_code_fade": 0.8,
    "confirm_quit": true,
    "cursor_blink": false,
    "tab_bar": { "show": true },
    "scrollbar": {
        "axes": {
            "horizontal": true,
            "vertical": false
        }
    },
    "tabs": {
        "file_icons": true,
        "git_status": true,
        "activate_on_close": "left_neighbour",
        "show_close_button": "hover"
    },
    "buffer_font_family": "SF Mono",
    "ui_font_size": 18,
    "ui_font_family": "SF Mono",
    "buffer_font_size": 16.0,
    "relative_line_numbers": "enabled",
    "tab_size": 4,
    "vertical_scroll_margin": 8,
    "format_on_save": "off",
    "vim_mode": true,
    "current_line_highlight": "all",
    "vim": {
        "cursor_shape": {
            "visual": "block",
            "insert": "inherit",
            "normal": "block"
        },
        "use_system_clipboard": "never"
    },
    "toolbar": {
        "quick_actions": false
    },
    "terminal": {
        "blinking": "on",
        "cursor_shape": "bar",
        "dock": "right",
        "toolbar": { "breadcrumbs": false }
    }
}
